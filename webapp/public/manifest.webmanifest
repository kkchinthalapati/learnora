{
  "name": "Learnora",
  "short_name": "Learnora",
  "description": "A focused study workspace — tasks, exams, timers, notes and AI-assisted revision in one place.",
  "start_url": "/app/",
  "scope": "/app/",
  "id": "/app/",
  "display": "standalone",
  "background_color": "#0d0c0a",
  "theme_color": "#0d0c0a",
  "icons": [
    {
      "src": "/app/learnora-mark.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/app/learnora.jpg",
      "sizes": "1024x1024",
      "type": "image/jpeg",
      "purpose": "any"
    },
    {
      "src": "/app/learnora.jpg",
      "sizes": "1024x1024",
      "type": "image/jpeg",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/app/capture",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf",
            "application/msword",
            ".doc",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".docx",
            "text/plain",
            ".txt",
            "image/*",
            "audio/*",
            ".mp3",
            ".m4a",
            ".wav",
            ".ogg"
          ]
        }
      ]
    }
  }
}
